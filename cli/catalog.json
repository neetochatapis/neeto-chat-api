        "flags": [
          {
            "name": "email",
            "type": "string",
            "description": "New email address"
          },
          {
            "name": "first-name",
            "type": "string",
            "description": "First name"
          },
          {
            "name": "last-name",
            "type": "string",
            "description": "Last name"
          },
          {
            "name": "role",
            "type": "string",
            "description": "Organization role name; e.g. Admin, Standard, Editor, Reviewer (case-sensitive, must match a role in your workspace)"
          },
          {
            "name": "time-zone",
            "type": "string",
            "description": "Time zone"
          }
        ]
