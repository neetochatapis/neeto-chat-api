        "flags": [
          {
            "name": "end-date",
            "type": "string",
            "description": "End date for a custom range (YYYY-MM-DD)"
          },
          {
            "name": "range-type",
            "type": "string",
            "description": "Date range type (e.g. last_7_days, last_30_days, custom_duration)"
          },
          {
            "name": "start-date",
            "type": "string",
            "description": "Start date for a custom range (YYYY-MM-DD)"
