  {
    "command": "neetochat team-members",
    "description": "Manage team members",
    "subcommands": [
      {
        "command": "neetochat team-members create",
        "description": "Invite team members",
        "flags": [
          {
            "name": "emails",
            "type": "string",
            "description": "Comma-separated email addresses to invite",
            "required": true
          },
          {
            "name": "role",
            "type": "string",
            "description": "Organization role name for the invited members; e.g. Admin, Standard, Editor, Reviewer (case-sensitive, must match a role in your workspace)",
            "required": true
          },
          {
            "name": "send-invitation-email",
            "type": "bool",
            "default": "true",
            "description": "Send invitation email"
          }
        ]
      },
      {
        "command": "neetochat team-members delete",
        "description": "Remove a team member"
      },
      {
        "command": "neetochat team-members list",
        "description": "List team members",
        "flags": [
          {
            "name": "email",
            "type": "string",
            "description": "Filter by email address"
          },
          {
            "name": "page",
            "type": "int",
            "default": "1",
            "description": "Page number"
          },
          {
            "name": "page-size",
            "type": "int",
            "default": "0",
            "description": "Items per page (max 100)"
          }
        ]
      },
      {
        "command": "neetochat team-members show",
        "description": "Show a team member"
      },
      {
        "command": "neetochat team-members update",
        "description": "Update a team member",
        "flags": [
          {
            "name": "email",
            "type": "string",
            "description": "New email address"
          },
          {
            "name": "first-name",
            "type": "string",
            "description": "First name"
          },
          {
            "name": "last-name",
            "type": "string",
            "description": "Last name"
          },
          {
            "name": "role",
            "type": "string",
            "description": "Organization role name; e.g. Admin, Standard, Editor, Reviewer (case-sensitive, must match a role in your workspace)"
          },
          {
            "name": "time-zone",
            "type": "string",
            "description": "Time zone"
          }
        ]
      }
    ]
  },
